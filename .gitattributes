# Golden files and committed bench data are compared byte-for-byte. Pinning them
# to LF keeps a Windows checkout from rewriting them to CRLF underneath the tests.
*.golden text eol=lf
*.golden.md text eol=lf
**/testdata/** text eol=lf
bench/** text eol=lf

# release-please rewrites the version pins in these in place, and the docs tests
# read the split asset links byte for byte, so a Windows checkout must keep LF.
README.md text eol=lf
docs/app.html text eol=lf
docs/index.html text eol=lf
