            0.9686,
            0.9725,
            0.9882
          ],
          "hex": "#f7f8fc"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "neutral",
            "background": true
          }
        }
      },
      "raised": {
        "$description": "Raised regions: sidebars, headers, table heads.",
