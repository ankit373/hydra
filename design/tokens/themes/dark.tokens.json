{
  "$extensions": {
    "mode": "dark",
    "dev.hydra.leonardo": {
      "background": "neutral",
      "lightness": 2
    }
  },
  "color": {
    "$type": "color",
    "surface": {
      "base": {
        "$description": "Page and window background. Opaque.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0235,
            0.0275,
            0.0588
          ],
          "hex": "#06070f"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "neutral",
            "background": true
          }
        }
      },
      "raised": {
        "$description": "Raised regions: sidebars, headers, table heads.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0392,
            0.0471,
            0.0941
          ],
          "hex": "#0a0c18"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "neutral",
            "ratio": 1.032
          }
        }
      },
      "card": {
        "$description": "Cards and panels.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0471,
            0.0588,
            0.1176
          ],
          "hex": "#0c0f1e"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "neutral",
            "ratio": 1.056
          }
        }
      },
      "overlay": {
        "$description": "Popovers, input wells, selected rows: the highest surface.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0588,
            0.0706,
            0.1373
          ],
          "hex": "#0f1223"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "neutral",
            "ratio": 1.074
          }
        }
      }
    },
    "border": {
      "subtle": {
        "$description": "Hairlines and dividers. Decorative, never the only boundary of a control.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.102,
            0.1176,
            0.1961
          ],
          "hex": "#1a1e32"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "neutral",
            "ratio": 1.215
          }
        }
      },
      "default": {
        "$description": "Card and control outlines.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1686,
            0.1843,
            0.2863
          ],
          "hex": "#2b2f49"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "neutral",
            "ratio": 1.53
          },
          "dev.hydra.terminal": {
            "ansi16": 8,
            "ansi256": "236"
          }
        }
      },
      "strong": {
        "$description": "Input and control borders that must read at 3:1 (WCAG 1.4.11).",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.3765,
            0.4,
            0.5451
          ],
          "hex": "#60668b"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "neutral",
            "ratio": 3.6
          },
          "dev.hydra.contrast": {
            "min": 3
          }
        }
      }
    },
    "text": {
      "default": {
        "$description": "Body text. In the TUI this is the terminal's own foreground.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9059,
            0.9137,
            0.9569
          ],
          "hex": "#e7e9f4"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "neutral",
            "ratio": 16.62
          },
          "dev.hydra.terminal": {
            "ansi16": "default"
          },
          "dev.hydra.contrast": {
            "min": 4.5,
            "apca": 75
          }
        }
      },
      "muted": {
        "$description": "Secondary text and labels.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.6745,
            0.698,
            0.8157
          ],
          "hex": "#acb2d0"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "neutral",
            "ratio": 9.6
