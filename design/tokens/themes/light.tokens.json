          "colorSpace": "srgb",
          "components": [
            0.9569,
            0.9608,
            0.9843
          ],
          "hex": "#f4f5fb"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "neutral",
            "ratio": 1.03
