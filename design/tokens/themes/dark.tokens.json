          "dev.hydra.terminal": {
            "ansi16": 7,
            "ansi256": "146"
          },
          "dev.hydra.contrast": {
            "min": 4.5,
            "apca": 60
          }
        }
      },
      "subtle": {
        "$description": "Metadata and hints. Never the only carrier of meaning.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.5098,
            0.5333,
            0.6784
          ],
          "hex": "#8288ad"
