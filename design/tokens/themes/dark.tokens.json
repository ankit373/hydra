          "dev.hydra.terminal": {
            "ansi16": 5,
            "ansi256": "141"
          },
          "dev.hydra.contrast": {
            "min": 4.5
          }
        }
      }
    },
    "status": {
      "success": {
        "$description": "Succeeded, enforced, added. Pair with a glyph or word.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2471,
            0.851,
            0.5412
          ],
          "hex": "#3fd98a"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "green",
            "ratio": 11
          },
          "dev.hydra.terminal": {
            "ansi16": 2,
            "ansi256": "42"
          },
          "dev.hydra.contrast": {
            "min": 4.5
          }
        }
      },
      "warning": {
        "$description": "Needs attention, waiting, degraded. Pair with a glyph or word.",
