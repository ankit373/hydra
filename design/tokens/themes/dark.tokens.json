    "focus": {
      "ring": {
        "$description": "Focus ring: 2px, 2px offset.",
        "$value": "{color.accent.default}"
      }
    },
    "brand": {
      "$description": "Logo and wordmark gradient only.",
      "start": {
        "$value": "{palette.brand.cyan}",
        "$extensions": {
          "dev.hydra.terminal": {
            "ansi16": 6,
            "ansi256": "51"
          },
          "dev.hydra.contrast": {
            "min": 4.5
          }
        }
      },
      "mid": {
        "$value": "{palette.brand.violet}",
        "$extensions": {
          "dev.hydra.terminal": {
            "ansi16": 5,
            "ansi256": "99"
