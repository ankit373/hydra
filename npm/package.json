    "model-routing",
    "ollama",
    "claude",
    "openai",
    "local-first"
  ],
  "homepage": "https://hydra.uvansa.com",
  "bugs": "https://github.com/ankit373/hydra/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankit373/hydra.git",
    "directory": "npm"
  },
  "license": "MIT",
  "author": "ankit373",
  "bin": {
    "hyctl": "bin/cli.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js"
  },
  "files": [
    "bin/cli.js",
    "scripts/postinstall.js"
  ],
  "os": [
    "darwin",
