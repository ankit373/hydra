# ── Runtime / mutable state ────────────────────────────────────────────────
logs/
!logs/.gitkeep
*.log
*.jsonl
# …except the checked-in format fixtures. They are files as an earlier Hydra
# wrote them, and the whole point is that they stay byte-identical — the
# backward-compatibility contract in internal/formats has nothing to compare
# against without them. The blanket *.jsonl rule above is for logs, and it
# silently swallowed them: the tests passed locally against files git had
# never seen, and failed on all three CI runners.
!internal/formats/testdata/*.jsonl
state.json
auth_required.json

# ── Secrets & local config ─────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local
.claude/settings.local.json

# ── Tool caches ────────────────────────────────────────────────────────────
.antigravitycli/

# ── Local build output ─────────────────────────────────────────────────────
# Anchored: an unanchored `hydra` would also ignore cmd/hydra/. A 17 MB build
# of this reached develop once already (#662).
/hyctl
/hydra

# ── Node / Bun ─────────────────────────────────────────────────────────────
node_modules/
desktop/frontend/node_modules/
dist/
/build/
out/
.cache/
.eslintcache
*.tsbuildinfo

# ── IDE / editor ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ── macOS ──────────────────────────────────────────────────────────────────
.DS_Store
__MACOSX/
Thumbs.db

# ── Temporary / backup files created by edit.sh ────────────────────────────
*.bak
*.orig
*.tmp
/context/edit_test.txt

# ── Lock files (keep bun.lock, ignore others) ──────────────────────────────
package-lock.json
yarn.lock
pnpm-lock.yaml
# The desktop frontend is npm, not bun, and its lockfile must be committed —
# without it `npm ci` cannot run and nobody builds the same bundle twice.
!desktop/frontend/package-lock.json

# Private planning docs — local-only scoping / planning / spec / review / design.
# NEVER commit these. Glob patterns catch future ones; explicit names below are legacy.
*_SCOPE.md
*_SCOPING.md
*_PLAN.md
*_PLANNING.md
*_SPEC.md
SPEC_*.md
*_REVIEW.md
*_MODEL.md
*_DRAFT.md
*_FINDINGS.md
*_PRIVATE.md
ROADMAP_PRIVATE.md
ARCHITECTURE_BRAIN.md
RESEARCH_FINDINGS.md
STRATEGY_REVIEW.md
ROADMAP_TRUST_CONTROL_PLANE.md
HYDRA_MANIFESTO.md
SPEC_TRUST_V1.md
BUILD_STATE.md
HYDRA_INFERENCE_SCOPING.md

# Python
__pycache__/
*.pyc

# gstack skill artifacts (security reports, local state)
.gstack/
