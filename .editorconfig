# Agreement about whitespace, so a diff shows what changed rather than which
# editor opened the file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
# gofmt's own rules. Never reformat Go by editor config; run gofmt.
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
