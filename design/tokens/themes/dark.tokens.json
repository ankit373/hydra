          "colorSpace": "srgb",
          "components": [
            0.8784,
            0.6627,
            0.2314
          ],
          "hex": "#e0a93b"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "amber",
            "ratio": 9.48
          },
          "dev.hydra.terminal": {
            "ansi16": 3,
            "ansi256": "179"
          },
          "dev.hydra.contrast": {
            "min": 4.5
          }
        }
      },
      "danger": {
        "$description": "Failed, blocked, removed. Pair with a glyph or word.",
