          "colorSpace": "srgb",
          "components": [
            1,
            0.3529,
            0.4314
          ],
          "hex": "#ff5a6e"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "red",
            "ratio": 6.64
          },
          "dev.hydra.terminal": {
            "ansi16": 1,
            "ansi256": "203"
          },
          "dev.hydra.contrast": {
            "min": 4.5
          }
        }
      },
      "info": {
        "$description": "Neutral notices.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.349,
            0.6549,
            0.9922
          ],
          "hex": "#59a7fd"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "blue",
            "ratio": 8
          },
          "dev.hydra.contrast": {
            "min": 4.5
          }
        }
      }
    },
    "cost": {
      "$description": "Cost bands are data, not status. They alias the status hues until charts move to the chart palette (Phase 4).",
      "low": {
        "$value": "{color.status.success}"
      },
      "mid": {
        "$value": "{color.status.warning}"
      },
      "high": {
        "$value": "{color.status.danger}"
      }
    },
    "chart": {
      "$description": "Categorical series in fixed order; never cycled. Validated with the dataviz palette validator against this theme.",
