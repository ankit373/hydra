        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "neutral",
            "ratio": 5.8
          },
          "dev.hydra.terminal": {
            "ansi16": 8,
            "ansi256": "103"
          },
          "dev.hydra.contrast": {
            "min": 4.5
          }
        }
      },
      "inverse": {
        "$description": "Text on a saturated fill (accent or status background).",
        "$value": "{color.surface.base}"
      }
    },
    "accent": {
      "default": {
        "$description": "The single interactive accent: links, primary actions, live values, selection.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0.902,
            0.7647
          ],
          "hex": "#00e6c3"
        },
        "$extensions": {
          "dev.hydra.leonardo": {
            "scale": "aqua",
            "ratio": 12.54
          },
          "dev.hydra.terminal": {
            "ansi16": 6,
            "ansi256": "43"
          },
          "dev.hydra.contrast": {
            "min": 4.5
          }
        }
      },
      "strong": {
        "$description": "Emphasis in a second, bluer teal: headings in data views, inline code.",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1647,
            0.9412,
            0.8784
          ],
          "hex": "#2af0e0"
        },
        "$extensions": {
