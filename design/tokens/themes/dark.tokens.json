          "dev.hydra.terminal": {
            "ansi16": 6,
            "ansi256": "51"
          },
          "dev.hydra.contrast": {
            "min": 4.5
          }
        }
      },
      "secondary": {
        "$description": "Secondary accent for tags and series that need a second hue. Not for actions.",
